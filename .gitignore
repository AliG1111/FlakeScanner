# Generated on the build machine by XcodeGen
*.xcodeproj/
build/
DerivedData/
Payload/
*.ipa
.DS_Store

# Secrets and signing material must never be committed
cert_key
cert_key.pub
AuthKey_*.p8
*.p8
*.p12
*.mobileprovision
*.cer

# CI and build output
logs/
dist/
*.xcresult
simulators.json

# Python lab caches and scratch output
__pycache__/
*.pyc
tools/lab/out/

# Plant media and run data must never be committed.
# Pictures and tables are treated as data unless they live in a whitelisted place.
*.jpg
*.jpeg
*.JPG
*.JPEG
*.png
*.PNG
*.tif
*.tiff
*.bmp
*.csv
!FlakeScanner/Assets.xcassets/**/*.png
!Tests/FlakeScannerTests/Fixtures/**
!tools/lab/fixtures/**
!docs/figures/*.png
# Folders copied from the phone (Files app) and exported zips. Anchored at the root where a source folder has the
# same name (FlakeScanner/Runs/, FlakeScanner/Diagnostics/).
*.zip
/Reference/
/PlantMedia/
/Runs/
/Snapshots/
/Diagnostics/
run_*/
snapshot_*/
diag_*/
*.mov
*.MOV
*.mp4
*.MP4
*.heic
*.HEIC
*.dng
*.DNG
